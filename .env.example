# Required for agent runs (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: model override (default claude-sonnet-5-5)
# ARGUS_MODEL=claude-sonnet-5-5

# Recommended: puts OpenAlex requests in the faster "polite pool"
OPENALEX_EMAIL=
# Optional, if OpenAlex issues you a key
OPENALEX_API_KEY=

# Optional: enables patent search (free key from https://patentsview.org)
PATENTSVIEW_API_KEY=
